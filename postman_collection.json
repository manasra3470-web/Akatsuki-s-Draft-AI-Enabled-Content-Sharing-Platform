        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post (Draft or Pending)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.post && json.data.post._id) {",
                  "    pm.collectionVariables.set('postId', json.data.post._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Art of Content Creation\",\n  \"description\": \"Exploration of storytelling and structure in digital publication.\",\n  \"content\": \"Compelling content requires clarity, emotional resonance, and consistent focus on user intent.\",\n  \"category\": \"Writing\",\n  \"image\": \"https://images.unsplash.com/photo-1455390582262-044cdead277a\",\n  \"status\": \"draft\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          }
        },
        {
          "name": "Get Public Approved Posts (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?page=1&limit=10&category=Writing&search=clarity",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "category",
                  "value": "Writing"
                },
                {
                  "key": "search",
                  "value": "clarity"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Posts (All Statuses)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/my-posts?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "my-posts"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Single Approved Post by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{postId}}"]
            }
          }
        },
        {
          "name": "Update Post (Submit to Pending / Edit)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Art of Content Creation - Refined\",\n  \"content\": \"Revised content detailing narrative pacing and visual composition.\",\n  \"status\": \"pending\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{postId}}"]
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{postId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Approval",
      "item": [
        {
          "name": "Get Pending Posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/posts/pending?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "posts", "pending"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Approve Pending Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/posts/approve/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "posts", "approve", "{{postId}}"]
            }
          }
        },
        {
          "name": "Reject Pending Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Please revise section 2 with clearer data sources before publication.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/posts/reject/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "posts", "reject", "{{postId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "AI Content Improvement",
      "item": [
        {
          "name": "Improve Post Content with Gemini AI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/improve/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "improve", "{{postId}}"]
            }
          }
        }
      ]
    }
  ]
}

